# Copy this file to .env.local and fill in what you have.
# Every variable is optional: without one, that feature turns itself off
# (or degrades) instead of breaking the site. See the README.

# Supabase: login, favorites, "I'm going" and reviews.
# URL looks like https://xxxx.supabase.co (no /rest/v1/ at the end).
# The key is the *publishable* key (sb_publishable_...). It is safe in the browser
# because Row Level Security protects the tables. Never use the secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps JavaScript API key (restrict it by HTTP referrer in Google Cloud).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Gemini API key for the natural-language search. Server only: NO NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=
